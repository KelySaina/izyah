# Backend-local env (used when running natively: npm run dev).
# In Docker these are injected by docker-compose from the root .env.

NODE_ENV=development
PORT=4000

# When running natively against docker-compose.dev.yml infra, use localhost.
DATABASE_URL=postgresql://izyah:izyah_dev_password_change_me@localhost:5432/izyah?schema=public
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:5173,http://izyah.localhost

SEED_ON_START=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=debug
ANALYTICS_ENABLED=true
# Run the BullMQ workers (media processing, notification fan-out) inline in
# the API process — dev convenience so a separate `npm run worker` isn't needed.
RUN_WORKER_INLINE=true

# MinIO (native dev points at localhost published ports).
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=izyah-minio
MINIO_ROOT_PASSWORD=izyah_minio_dev_password_change_me
MINIO_BUCKET_MEDIA=izyah-media
MINIO_BUCKET_AVATARS=izyah-avatars
MINIO_PUBLIC_URL=http://localhost:9000
