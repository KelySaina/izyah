# Frontend build-time env (Vite exposes only VITE_* to the client).

# When running the app natively (npm run dev) point at the local backend.
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# When running the full Docker stack, Caddy serves the API at:
# VITE_API_URL=http://api.izyah.localhost
# VITE_SOCKET_URL=http://api.izyah.localhost
