# ============================================================================
# Izy'Ah — root environment (consumed by docker-compose)
# Copy to .env and adjust. NEVER commit the real .env.
# ============================================================================

# --- Domains (Caddy site addresses) ------------------------------------------
# *.localhost resolves to 127.0.0.1 in modern browsers, so this works with no
# /etc/hosts edits for local development.
APP_DOMAIN=izyah.localhost
API_DOMAIN=api.izyah.localhost
MINIO_CONSOLE_DOMAIN=minio.izyah.localhost
ADMINER_DOMAIN=db.izyah.localhost
AUTH_DOMAIN=auth.izyah.localhost
AUTH_ADMIN_DOMAIN=auth-admin.izyah.localhost

# HTTP Basic Auth in front of Adminer, applied by Caddy (infra/caddy/izyah.caddyfile).
# This dev-only default is user "admin", password "admin".
#
# It must be BCRYPT. Traefik accepted the apr1 hash that `openssl passwd -apr1`
# produces and Caddy does not, so a hash carried over from the Traefik setup will
# be rejected at reload. Mint one with:
#     caddy hash-password --plaintext '<password>'
# and double every literal `$` in the result, because docker compose interpolates
# $VAR in .env files too. Empty here and scripts/caddy-site.sh refuses to install
# rather than publish Adminer — which talks straight to the production database —
# with no password at all.
ADMIN_AUTH_USER=admin
ADMIN_AUTH_BCRYPT=$$2a$$14$$iuJdA/WuVdk2zxTlJNEMmucHNxexMeYz2c9O/tZ4w4pOt1j7cStpK

# Public URL the frontend uses to reach the API (browser-side).
VITE_API_URL=http://api.izyah.localhost
VITE_SOCKET_URL=http://api.izyah.localhost

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=izyah
POSTGRES_PASSWORD=izyah_dev_password_change_me
POSTGRES_DB=izyah
# In-cluster URL used by the backend container.
DATABASE_URL=postgresql://izyah:izyah_dev_password_change_me@postgres:5432/izyah?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- MinIO / S3 -------------------------------------------------------------
MINIO_ROOT_USER=izyah-minio
MINIO_ROOT_PASSWORD=izyah_minio_dev_password_change_me
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_MEDIA=izyah-media
MINIO_BUCKET_AVATARS=izyah-avatars
# Public base used to build browser-facing object URLs.
MINIO_PUBLIC_URL=http://minio.izyah.localhost

# --- Backend ----------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=4000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://izyah.localhost,http://localhost:5173
# Seed the database on container start (dev convenience).
SEED_ON_START=true
# Rate limiting (per identity / IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info

# --- Analytics --------------------------------------------------------------
# Privacy-friendly, self-hosted event logging toggle.
ANALYTICS_ENABLED=true

# --- Auth / identity --------------------------------------------------------
# HMAC key for anonymous session tokens. GENERATE A REAL ONE: `openssl rand -hex 32`.
SESSION_SECRET=dev-insecure-session-secret-change-me!!
# Public URL of the frontend (used to build OIDC redirect/callback links).
APP_URL=http://izyah.localhost

# --- OIDC (Logto) — fill in after provisioning (see SETUP-AUTH.md) ----------
# Leave OIDC_ISSUER empty to run anonymous-only (account-linking disabled).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=

# --- Web Push ----------------------------------------------------------
# Generate a pair with `npx web-push generate-vapid-keys`. Leave both blank
# to disable push delivery (in-app/socket notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@izyah.app

# --- Backups (backup service — scripts/backup-cron.js) ---------------------
# Cron expression for how often it runs. Leave blank for the built-in default
# (weekly, Sun 03:30 UTC) — see that file's header for other presets.
BACKUP_SCHEDULE=
# How many backups/izyah-backup-*.tar.gz archives to keep; oldest are pruned
# after each run. Leave blank for the built-in default (8).
BACKUP_KEEP=

# --- Host ports for the reverse proxy --------------------------------------
# Caddy runs on the host, outside docker, so it reaches each service through a
# published port rather than over the compose network. 127.0.0.1 keeps them off
# every other interface, which is what makes the proxy the only way in: on
# 0.0.0.0 the app also answers in plain http on these ports, around the TLS.
HOST_BIND=127.0.0.1
FRONTEND_HOST_PORT=4310
BACKEND_HOST_PORT=4311
ADMINER_HOST_PORT=4312
MINIO_HOST_PORT=4313
MINIO_CONSOLE_HOST_PORT=4314
# Only reachable when the `auth` compose profile is up (logto is dormant).
AUTH_HOST_PORT=4315
AUTH_ADMIN_HOST_PORT=4316
